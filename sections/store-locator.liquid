{{ 'store-locator.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400&family=Newsreader:opsz,wght@6..72,200;6..72,300&display=swap">

<div class="wr-locator" data-wr-locator style="--wr-height: {{ section.settings.height }}px;">
  <div class="wr-locator__inner">
    {%- if section.settings.title != blank -%}
      <h2 class="wr-locator__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="wr-locator__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    <div class="wr-locator__layout">
      <div class="wr-locator__panel">
        <form class="wr-locator__search" data-wr-form role="search">
          <div class="wr-locator__row">
            <input class="wr-locator__input" data-wr-input type="search" autocomplete="postal-code"
                   placeholder="{{ section.settings.placeholder | escape }}"
                   aria-label="{{ section.settings.placeholder | escape }}">
            <button class="wr-locator__btn" type="submit">Zoek</button>
          </div>
          <button class="wr-locator__btn wr-locator__btn--ghost" type="button" data-wr-locate>Gebruik mijn locatie</button>
          <div class="wr-locator__status" data-wr-status aria-live="polite"></div>
        </form>
        <div class="wr-locator__count" data-wr-count></div>
        <ul class="wr-locator__list" data-wr-list></ul>
      </div>
      <div class="wr-locator__map-wrap"><div class="wr-locator__map" data-wr-map></div></div>
    </div>
  </div>

  <script type="application/json" data-wr-config>
    {
      "centerLat": {{ section.settings.center_lat | default: '50.85' | json }},
      "centerLng": {{ section.settings.center_lng | default: '4.35' | json }},
      "zoom": {{ section.settings.zoom | json }},
      "countries": {{ section.settings.countries | json }},
      "studios": [
        {%- for block in section.blocks -%}
          {
            "name": {{ block.settings.name | json }},
            "address": {{ block.settings.address | json }},
            "lat": {{ block.settings.lat | json }},
            "lng": {{ block.settings.lng | json }},
            "types": {{ block.settings.reformers | split: ',' | json }},
            "image": {{ block.settings.image | image_url: width: 400 | json }},
            "url": {{ block.settings.url | json }},
            "phone": {{ block.settings.phone | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="{{ 'store-locator.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Store locator",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Vind een studio" },
    { "type": "textarea", "id": "intro", "label": "Introductietekst", "default": "Ontdek waar je Wood Reformer in het echt kan proberen. Voer je postcode of stad in en vind de studio’s in jouw buurt." },
    { "type": "text", "id": "placeholder", "label": "Placeholder zoekveld", "default": "Postcode of stad" },
    { "type": "text", "id": "countries", "label": "Landen voor zoeken (ISO-codes)", "default": "be,nl,fr,de,lu", "info": "Beperkt de zoekresultaten, bv. be,nl. Leeg laten = wereldwijd." },
    { "type": "range", "id": "height", "label": "Hoogte (px, desktop)", "min": 480, "max": 1000, "step": 20, "default": 720 },
    { "type": "text", "id": "center_lat", "label": "Startpunt kaart: breedtegraad", "default": "50.85" },
    { "type": "text", "id": "center_lng", "label": "Startpunt kaart: lengtegraad", "default": "4.35" },
    { "type": "range", "id": "zoom", "label": "Startzoom", "min": 3, "max": 12, "default": 7 }
  ],
  "blocks": [
    {
      "type": "studio",
      "name": "Studio",
      "settings": [
        { "type": "text", "id": "name", "label": "Naam studio" },
        { "type": "textarea", "id": "address", "label": "Adres", "info": "Straat, nr, postcode, stad, land" },
        { "type": "text", "id": "reformers", "label": "Type reformer(s)", "info": "Meerdere? Scheiden met een komma, bv. Reformer Classic, Reformer Pro" },
        { "type": "image_picker", "id": "image", "label": "Foto studio" },
        { "type": "text", "id": "lat", "label": "Breedtegraad (optioneel)", "info": "Leeg = adres wordt automatisch opgezocht. Sneller en betrouwbaarder met coördinaten." },
        { "type": "text", "id": "lng", "label": "Lengtegraad (optioneel)" },
        { "type": "url", "id": "url", "label": "Website studio (optioneel)" },
        { "type": "text", "id": "phone", "label": "Telefoon (optioneel)" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "Store locator" }]
}
{% endschema %}
